<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoWarn>$(NoWarn);CA1416;xUnit1051</NoWarn>
		<RootNamespace>MonacoEditorComponent.Tests</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3.mtp-v2" />
		<PackageReference Include="Microsoft.Playwright.Xunit.v3" />
		<!-- Suppress Microsoft.Playwright build/buildTransitive targets that copy .playwright/ and
		     playwright.ps1 into a subdirectory named after the assembly, conflicting with the
		     executable on macOS/Linux when UseArtifactsOutput is active.
		     CI installs Playwright browsers via the NuGet global cache instead. -->
		<PackageReference Include="Microsoft.Playwright" ExcludeAssets="build;buildTransitive;native" />
		<PackageReference Include="StreamJsonRpc" />
		<PackageReference Include="Nerdbank.Streams" />
		<PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Testing.Extensions.TrxReport" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MonacoEditorComponent\MonacoEditorComponent.csproj" />
	</ItemGroup>

</Project>
