<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<!--
			Uno 7's UNOB0029 rejects any Exe that references Uno.WinUI without the Uno.Sdk, and only
			exempts projects with IsTestProject=true. xunit.v3.mtp-v2 marks this project as a testing
			platform application but leaves IsTestProject unset, so say it explicitly.
		-->
		<IsTestProject>true</IsTestProject>
		<!--
			UNOB0025: the library reference brings Uno.Foundation/Uno.WinRT without a runtime host.
			Intentional: these tests exercise the bridge and serialization layers in-process and drive
			the real UI through the separately built TestApp, so no Uno runtime is needed here.
		-->
		<MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);UNOB0025</MSBuildWarningsAsMessages>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoWarn>$(NoWarn);CA1416;xUnit1051</NoWarn>
		<RootNamespace>MonacoEditorComponent.Tests</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3.mtp-v2" />
		<PackageReference Include="Microsoft.Playwright.Xunit.v3" />
		<!--
			ExcludeAssets build/buildTransitive: skip the Playwright targets that copy the
			.playwright driver folder into the output (they misbehave under UseArtifactsOutput).
			GeneratePathProperty: expose $(PkgMicrosoft_Playwright) so we can point the driver
			search path at the NuGet package root (which contains .playwright/) instead.
		-->
		<PackageReference Include="Microsoft.Playwright" ExcludeAssets="build;buildTransitive" GeneratePathProperty="true" />
		<PackageReference Include="StreamJsonRpc" />
		<PackageReference Include="Nerdbank.Streams" />
		<PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Testing.Extensions.TrxReport" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MonacoEditorComponent\MonacoEditorComponent.csproj" />
	</ItemGroup>

	<!--
		Surface the Microsoft.Playwright NuGet package path to runtime so DesktopAppFixture
		can set PLAYWRIGHT_DRIVER_SEARCH_PATH locally (CI sets it explicitly). Version-agnostic
		via the GeneratePathProperty above; resolved at build time, never hardcoded.
	-->
	<ItemGroup>
		<AssemblyMetadata Include="PlaywrightPackagePath" Value="$(PkgMicrosoft_Playwright)" />
	</ItemGroup>

</Project>
