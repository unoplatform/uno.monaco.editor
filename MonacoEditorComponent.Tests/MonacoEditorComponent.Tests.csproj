<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoWarn>$(NoWarn);CA1416;xUnit1051</NoWarn>
		<RootNamespace>MonacoEditorComponent.Tests</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3.mtp-v2" />
		<!-- Playwright runtime is referenced for integration tests.
		     Build/buildTransitive assets are excluded to prevent the Playwright targets
		     from copying node driver files into a subdirectory that conflicts with the
		     exe output file on macOS/Linux (UseArtifactsOutput + OutputType=Exe).
		     CI installs the Playwright driver post-build via a dedicated step.
		     Note: Microsoft.Playwright.Xunit.v3 was reverted to Microsoft.Playwright because
		     the TestAdapter brought by Xunit.v3 causes fixture disposal hangs on CI. -->
		<PackageReference Include="Microsoft.Playwright" IncludeAssets="compile;runtime" PrivateAssets="contentFiles;build;buildTransitive;analyzers;native" />
		<PackageReference Include="StreamJsonRpc" />
		<PackageReference Include="Nerdbank.Streams" />
		<PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Testing.Extensions.TrxReport" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MonacoEditorComponent\MonacoEditorComponent.csproj" />
	</ItemGroup>

</Project>
