<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoWarn>$(NoWarn);CA1416;xUnit1051</NoWarn>
		<RootNamespace>MonacoEditorComponent.Tests</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3.mtp-v2" />
		<PackageReference Include="Microsoft.Playwright.Xunit.v3" />
		<!-- Suppress Playwright build targets that conflict with UseArtifactsOutput.
		     The targets create an assembly-named subdirectory that collides with the exe
		     output on macOS/Linux (MSB3024). CI installs browsers from NuGet cache. -->
		<PackageReference Include="Microsoft.Playwright" ExcludeAssets="build;buildTransitive" />
		<PackageReference Include="StreamJsonRpc" />
		<PackageReference Include="Nerdbank.Streams" />
		<PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Testing.Extensions.TrxReport" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MonacoEditorComponent\MonacoEditorComponent.csproj" />
	</ItemGroup>

</Project>
