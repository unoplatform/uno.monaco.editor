{
  "compilerOptions": {
    "target": "ES2015",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2015", "DOM"],
    "noEmit": true,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "rootDir": "ts-helpermethods",
    "baseUrl": "..",
    "paths": {
      "monaco-editor": ["node_modules/monaco-editor"]
    }
  },
  "include": [
    "ts-helpermethods/**/*"
  ]
}
