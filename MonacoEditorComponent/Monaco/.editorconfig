root = false

[*.cs]

# Naming rule violation: Missing prefix: 'I'
dotnet_diagnostic.IDE1006.severity = none

# Naming: identifiers should have the right prefix
dotnet_diagnostic.CA1715.severity = none

# CS1591: Generated Monaco types now have XML docs from upstream JSDoc (fn-10.2).
# Severity raised from none to suggestion; full warning enforcement deferred until
# the complete API surface type regeneration is done (avoids breaking hand-written
# helper types that lack upstream JSDoc).
dotnet_diagnostic.CS1591.severity = suggestion

# Hand-written LanguagesHelper files re-enable CS1591 so undocumented public APIs fail build.
[LanguagesHelper*.cs]
dotnet_diagnostic.CS1591.severity = warning