<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Title>Monaco Editor Component</Title>
		<!--
			SYSLIB1031: Monaco.Uri and System.Uri both appear as discovered types in
			MonacoJsonContext (from IMarkdownString.Uris and IRelatedInformation.Resource).
			The source generator picks the first and warns about the TypeInfo property name
			collision. This is safe — both types serialize correctly via their own metadata.
			A dedicated test (UriCollision_BothTypesSerializeCorrectly) validates this.
			Cannot use #pragma in user code because SG diagnostics are emitted on generated files.
		-->
		<NoWarn>$(NoWarn);Uno0001;CA1416;CS1998;CS0067;SYSLIB1031</NoWarn>
		<PackageId>Uno.Monaco.Editor</PackageId>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>

    <GenerateLibraryLayout>true</GenerateLibraryLayout>
		<MonoRuntimeDebuggerEnabled>true</MonoRuntimeDebuggerEnabled>
		<Product>Uno.Monaco.Editor</Product>
		<Description>A cross-platform wrapper around the web-based Monaco Editor for WASM and Desktop (Skia). Designed for use with the Uno Platform</Description>
    <Authors>Uno Platform</Authors>
    <Copyright>Copyright (C) 2015-$([System.DateTime]::UtcNow.Year) Uno Platform inc. - all rights reserved</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/unoplatform/uno.monaco.editor</RepositoryUrl>
		<PackageProjectUrl>https://github.com/unoplatform/uno.monaco.editor</PackageProjectUrl>
    <PackageTags>wasm desktop skia monaco editor controls</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GeneratePackageOnBuild Condition="'$(Configuration)'=='Release'">true</GeneratePackageOnBuild>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- pick the first TFM from TargetFrameworks -->
    <IncludeContentInPack>false</IncludeContentInPack>
    <_PrimaryTfm>$([System.String]::Copy('$(TargetFrameworks)').Split(';')[0])</_PrimaryTfm>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>
      $(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb
    </AllowedOutputExtensionsInPackageBuildOutputFolder>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Nito.AsyncEx" />
		<PackageReference Include="StreamJsonRpc" />
		<PackageReference Include="Uno.CommunityToolkit.WinUI" />
		<PackageReference Include="Uno.WinUI" />
		<PackageReference Include="Uno.Core.Extensions.Logging" />
		<PackageReference Include="Uno.Core.Extensions.Logging.Singleton" />
	</ItemGroup>

	<ItemGroup>
		<Page Include="Themes\Generic.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</Page>
	</ItemGroup>

	<!-- ============================================================ -->
	<!-- TypeScript/JavaScript resources                               -->
	<!-- esbuild replaces tsc; TypeScript MSBuild package removed.     -->
	<!-- Monaco is bundled from node_modules (no vendored directory).  -->
	<!-- ============================================================ -->

	<!-- Exclude TypeScript source from compile (esbuild handles it) -->
	<ItemGroup>
		<None Remove="ts-helpermethods\**\*.ts" />
		<None Remove="ts-helpermethods\**\*.css" />
		<None Remove="tsconfig.json" />
	</ItemGroup>

	<!--
		WASM: EmbeddedResource for the main bundle, the CSS, and the editor worker.

		The editor worker is required, not an optimization. The diff editor computes its diff
		through EditorWorkerService, and without a reachable worker that computation never
		completes: Monaco's documented "fall back to the main thread" path only triggers when
		the Worker constructor throws, and a 404 URL fails asynchronously instead, so the
		internal $ping never settles. Observed directly: the diff editor rendered both documents
		correctly but produced no hunks and getLineChanges() stayed null, while the dev server
		logged a 404 for package_<hash>/workers/editor.worker.js.

		The four language workers (json/css/html/ts) stay unembedded. They are ~8.2 MB of
		download, main-thread parse time, and resident WASM linear memory, and nothing in the
		component's supported surface requires them; their absence only degrades the built-in
		language services for those four languages, which is the pre-existing behavior.

		Name mismatch, now handled in ts-helpermethods/index.ts: Uno.Wasm.Bootstrap's shell task
		flattens the worker path to the dot-joined name "workers.editor.worker.js" in
		wwwroot/package_&lt;hash&gt;/, with no "workers/" directory in the deployed output.
		resolveWorkerUrl therefore requests the flattened name on WASM and the real subdirectory
		on desktop, where the Content items below place the workers next to editor.html. index.ts
		also overrides getWorker rather than getWorkerUrl, because Monaco 0.52's ESM build
		constructs getWorkerUrl results with { type: 'module' } while these bundles are IIFE.

		The CSS entry needs the WasmCSS logical name, not the WasmScripts one its file path
		implies. Uno.Wasm.Bootstrap deploys and <link>s embedded resources whose manifest name
		contains ".WasmCSS." (that is how Uno's own uno.css and the app's Fonts.css arrive), and
		extracts ".WasmScripts." ones as scripts, where a .css file is silently dropped. Under
		the WasmScripts name the stylesheet was embedded in the assembly and never reached the
		page: verified in Chromium against the built app, document.styleSheets held only Uno's
		four sheets plus Monaco's runtime-injected theme rules, with no rule for ".monaco-editor"
		at all. Monaco's inline layout styles hide most of it, but the codicon @font-face is in
		this file, so every Monaco icon rendered as tofu, action-bar lists kept their bullets,
		and the line-number margin lost its styling. Desktop was never affected: editor.html
		links the copy in DesktopContent. Only the ".WasmCSS." infix is load-bearing; the
		prefix is $(RootNamespace), the same one MSBuild would derive for the sibling .js
		resource, so a rename keeps the two consistent.

		Every generated path below is declared unconditionally, and that is load-bearing. These
		files do not exist in a clean checkout — esbuild writes them from the targets at the
		bottom of this file, which run BeforeTargets="CoreCompile". An `Exists()` condition on the
		item is evaluated during project *evaluation*, long before any target runs, so on the first
		build after a clean checkout it is false and the item silently disappears; the second build
		picks it up because the first one left the file behind. That is exactly how the WASM
		stylesheet went missing again after the WasmCSS fix above: CI never sees it, because the
		workflow runs `npm run build` before `dotnet build`. Reproduced by clearing obj/ and
		rebuilding, then confirmed by disabling the sheet in the running page — the multi-file
		header fell back to Times New Roman and the collapse chevron and +/- change markers
		rendered as tofu. Missing files are caught by ValidateEsbuildBundles instead, which runs
		after generation and can therefore tell the truth.
	-->
	<ItemGroup>
		<EmbeddedResource Include="Properties\MonacoEditorComponent.rd.xml" />
		<EmbeddedResource Include="WasmScripts\uno-monaco-helpers.js" />
		<EmbeddedResource Include="WasmScripts\uno-monaco-helpers.css" LogicalName="$(RootNamespace).WasmCSS.uno-monaco-helpers.css" />
		<EmbeddedResource Include="WasmScripts\workers\editor.worker.js" />
	</ItemGroup>

	<!-- Desktop: Content files copied to output directory -->
	<ItemGroup>
		<Content Include="DesktopContent\editor.html" CopyToOutputDirectory="PreserveNewest" Link="DesktopContent\editor.html" />
		<Content Include="DesktopContent\uno-monaco-helpers.js" CopyToOutputDirectory="PreserveNewest" Link="DesktopContent\uno-monaco-helpers.js" />
		<Content Include="DesktopContent\uno-monaco-helpers.css" CopyToOutputDirectory="PreserveNewest" Link="DesktopContent\uno-monaco-helpers.css" />
		<Content Include="DesktopContent\workers\editor.worker.js" CopyToOutputDirectory="PreserveNewest" Link="DesktopContent\workers\editor.worker.js" />
		<Content Include="DesktopContent\workers\json.worker.js" CopyToOutputDirectory="PreserveNewest" Link="DesktopContent\workers\json.worker.js" />
		<Content Include="DesktopContent\workers\css.worker.js" CopyToOutputDirectory="PreserveNewest" Link="DesktopContent\workers\css.worker.js" />
		<Content Include="DesktopContent\workers\html.worker.js" CopyToOutputDirectory="PreserveNewest" Link="DesktopContent\workers\html.worker.js" />
		<Content Include="DesktopContent\workers\ts.worker.js" CopyToOutputDirectory="PreserveNewest" Link="DesktopContent\workers\ts.worker.js" />
	</ItemGroup>

	<!--
		Include repository-root README in NuGet package.
		The standard <None Pack="true"/> pattern does not work here because the Uno SDK's
		GenerateLibraryLayout=true packing flow does not propagate Pack metadata from None
		items to the package file list. Injecting into _PackageFiles via a target is the
		workaround recommended for Uno Platform library projects.
	-->
	<Target Name="_IncludeReadmeInPackage" BeforeTargets="GenerateNuspec">
		<ItemGroup>
			<_PackageFiles Include="..\README.md" PackagePath="/" />
		</ItemGroup>
	</Target>

	<!-- Rebuild Monaco JS bundles when TypeScript sources change -->
	<ItemGroup>
		<MonacoBundleInput Include="ts-helpermethods\**\*.ts" />
		<MonacoBundleInput Include="ts-helpermethods\**\*.css" />
		<MonacoBundleInput Include="ts-helpermethods\esbuild.config.mjs" />
		<MonacoBundleInput Include="..\package.json" />
		<MonacoBundleInput Include="..\package-lock.json" />
	</ItemGroup>

	<!--
		The stylesheets are in Outputs as well as the scripts. Both are products of the same
		esbuild run, but MSBuild only re-runs the target when one of the paths it is *told* about
		has gone missing or stale: with the .js alone listed, deleting just the .css left this
		target up to date and RestoreMonacoBundles skipped too (it tests the .js), so nothing ever
		regenerated the stylesheet.
	-->
	<Target Name="BuildMonacoBundlesWhenSourcesChange"
		BeforeTargets="CoreCompile"
		Inputs="@(MonacoBundleInput)"
		Outputs="WasmScripts\uno-monaco-helpers.js;WasmScripts\uno-monaco-helpers.css;DesktopContent\uno-monaco-helpers.js;DesktopContent\uno-monaco-helpers.css">
		<Message Importance="high" Text="Monaco TypeScript sources changed — rebuilding JS bundles..." />
		<Exec Command="npm install" WorkingDirectory="$(MSBuildThisFileDirectory).." StandardOutputImportance="low" Condition="!Exists('$(MSBuildThisFileDirectory)..\node_modules')" />
		<Exec Command="node MonacoEditorComponent/ts-helpermethods/esbuild.config.mjs" WorkingDirectory="$(MSBuildThisFileDirectory).." />
	</Target>

	<!-- Auto-restore Monaco JS bundles when missing (clean checkout) -->
	<Target Name="RestoreMonacoBundles"
		BeforeTargets="CoreCompile"
		Condition="!Exists('WasmScripts\uno-monaco-helpers.js')">
		<Message Importance="high" Text="Monaco JS bundles not found — running npm install and esbuild..." />
		<Exec Command="npm install" WorkingDirectory="$(MSBuildThisFileDirectory).." StandardOutputImportance="low" />
		<Exec Command="node MonacoEditorComponent/ts-helpermethods/esbuild.config.mjs" WorkingDirectory="$(MSBuildThisFileDirectory).." />
	</Target>

	<!--
		Safety net: fail with one clear message if any generated bundle is still missing once the
		two targets above have had their chance. Every path listed is declared unconditionally as
		an EmbeddedResource or Content item, so a missing one is a build break regardless — this
		only decides whether the developer reads an actionable sentence or a csc/Copy error naming
		a single file. The stylesheets are included deliberately: they were the one pair of
		generated outputs nothing here guarded, which is why a build that shipped without the WASM
		stylesheet stayed silent all the way to the browser. The DesktopContent copies are checked
		at their own paths rather than inferred from the WasmScripts originals, because the Content
		items above are what the desktop build actually consumes.
	-->
	<Target Name="ValidateEsbuildBundles" BeforeTargets="CoreCompile" DependsOnTargets="RestoreMonacoBundles">
		<ItemGroup>
			<_MonacoGeneratedBundle Include="WasmScripts\uno-monaco-helpers.js;WasmScripts\uno-monaco-helpers.css" />
			<_MonacoGeneratedBundle Include="WasmScripts\workers\editor.worker.js;WasmScripts\workers\json.worker.js;WasmScripts\workers\css.worker.js;WasmScripts\workers\html.worker.js;WasmScripts\workers\ts.worker.js" />
			<_MonacoGeneratedBundle Include="DesktopContent\uno-monaco-helpers.js;DesktopContent\uno-monaco-helpers.css" />
			<_MonacoGeneratedBundle Include="DesktopContent\workers\editor.worker.js;DesktopContent\workers\json.worker.js;DesktopContent\workers\css.worker.js;DesktopContent\workers\html.worker.js;DesktopContent\workers\ts.worker.js" />
			<_MonacoMissingBundle Include="@(_MonacoGeneratedBundle)" Condition="!Exists('%(Identity)')" />
		</ItemGroup>
		<Error
			Condition="'@(_MonacoMissingBundle)' != ''"
			Text="esbuild output missing: @(_MonacoMissingBundle, ', '). Run 'npm install &amp;&amp; npm run build' from the repository root." />
	</Target>

</Project>
