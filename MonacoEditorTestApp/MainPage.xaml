<Page x:Class="MonacoEditorTestApp.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:MonacoEditorTestApp"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- Collapsed unless MONACO_DIFF_TAB=1; see MainPage_Loaded. Kept out of the
                 TabView because TabView virtualizes non-selected tab content, so a diff
                 editor in a tab is never realized until a human clicks it, and the CDP
                 harness drives WebView contents rather than the XAML tree. -->
            <RowDefinition x:Name="DiffPanelRow" Height="0" />
            <!-- Same reasoning as DiffPanelRow, for MultiDiffCodeEditor. Gated on
                 MONACO_MULTIDIFF_TAB=1 on desktop, always shown on WASM so the Playwright suite
                 can reach it; DiffEditorCases scopes its expressions structurally rather than by
                 editor count precisely because this panel adds more of them to the same page. -->
            <RowDefinition x:Name="MultiDiffPanelRow" Height="0" />
        </Grid.RowDefinitions>

        <muxc:TabView x:Name="editors"
                      Grid.Row="0"
                      AddTabButtonClick="TabView_AddTabButtonClick"
                      TabCloseRequested="TabView_TabCloseRequested" />

        <ContentControl x:Name="DiffPanelHost"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />

        <ContentControl x:Name="MultiDiffPanelHost"
                        Grid.Row="2"
                        Visibility="Collapsed"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
    </Grid>
</Page>
