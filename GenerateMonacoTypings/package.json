{
  "name": "generatemonacotypings",
  "version": "2.0.0",
  "description": "Generates C# typings for the Monaco editor from TypeScript definitions. Includes a post-processing step to emit System.Text.Json attributes.",
  "main": "index.js",
  "scripts": {
    "generate": "pwsh -NoProfile -ExecutionPolicy Unrestricted -File ./generate-typings.ps1",
    "postprocess": "pwsh -NoProfile -ExecutionPolicy Unrestricted -File ./postprocess-stj.ps1",
    "postprocess:standalone": "pwsh -NoProfile -ExecutionPolicy Unrestricted -File ./postprocess-stj.ps1 -Standalone"
  },
  "author": "",
  "license": "MIT",
  "config": {
    "outdir": "./output",
    "typedocConverter": "https://github.com/hez2010/TypedocConverter/releases/download/v2.6/Windows_x64_Native.zip"
  },
  "dependencies": {
    "monaco-editor": "0.54.0"
  },
  "devDependencies": {
    "typedoc": "0.20.37",
    "typescript": "4.2.4"
  }
}
